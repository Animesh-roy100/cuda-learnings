# ---- build output (regenerable) ----
build/
bin/
*.exe
*.obj
*.lib
*.exp
*.pdb
*.ilk

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ---- editors / OS ----
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# Nsight Compute CSVs are machine-specific and currently hold only error
# output. The nsys timelines ARE kept as evidence of the profiling work.
# Note the ** prefix: a pattern containing a slash anchors to the repo root,
# so plain "profiles/..." would not match cuda-portfolio/profiles/...
**/profiles/*_ncu.csv
**/profiles/*.sqlite

# compute-sanitizer logs (scripts/sanitize.*)
cuda-portfolio/sanitizer/

# Downloaded model weights (scripts/fetch_model.*) -- never committed
cuda-portfolio/models/
